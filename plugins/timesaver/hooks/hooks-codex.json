{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/bun-runtime.sh\" \"${PLUGIN_ROOT}/scripts/session-start.ts\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/codex-precompact.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
